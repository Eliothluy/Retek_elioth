# ---- Server ----
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://retek:retek@localhost:5432/retek?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_SECRET=change-me-in-production-super-secret-key
JWT_REFRESH_SECRET=change-me-refresh-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
